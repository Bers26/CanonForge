{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonforge.local/schemas/roster-proposal-0.1.0.json",
  "title": "CanonForge Roster Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","sourceId","chunkId","mentions","aliasClaims"],
  "properties": {
    "schemaVersion": {"const":"0.1.0"},
    "sourceId": {"type":"string","minLength":1},
    "chunkId": {"type":"string","minLength":1},
    "mentions": {
      "type":"array",
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required": ["mentionId","primaryName","sourceIdentityKey","evidence","signals"],
        "properties": {
          "mentionId":{"type":"string","minLength":1},
          "primaryName":{"type":"string","minLength":1},
          "sourceIdentityKey":{"type":["string","null"]},
          "evidence":{"$ref":"#/$defs/locator"},
          "signals":{
            "type":"array",
            "uniqueItems":true,
            "items":{"enum":["dialogue","action","description","relationship","named","player"]}
          }
        }
      }
    },
    "aliasClaims":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["left","right","basis","evidence"],
        "properties":{
          "left":{"type":"string","minLength":1},
          "right":{"type":"string","minLength":1},
          "basis":{"enum":["explicit","probable"]},
          "evidence":{"$ref":"#/$defs/locator"}
        }
      }
    }
  },
  "$defs":{
    "locator":{
      "type":"object",
      "additionalProperties":false,
      "required":["quote","occurrence"],
      "properties":{
        "quote":{"type":"string","minLength":1},
        "occurrence":{"type":"integer","minimum":0}
      }
    }
  }
}
